# Copy this file to .env.local and fill in the two values from your Supabase
# project (Dashboard -> Project Settings -> API). Both are meant to be public:
# the browser key is safe in a bundle because Row Level Security, not the key,
# is what decides who can read what. Never put a *secret* / *service role* key
# here — that one bypasses RLS entirely and must never reach a client.

VITE_SUPABASE_URL=https://your-project-ref.supabase.co

# Supabase renamed this key. Newer projects show it as "publishable" and it
# looks like sb_publishable_...; older ones call it "anon public" and it is a
# JWT starting eyJ... . The app accepts either name, so set whichever one your
# dashboard shows you. If both are set, the publishable one wins.
VITE_SUPABASE_PUBLISHABLE_KEY=sb_publishable_your-key
# VITE_SUPABASE_ANON_KEY=eyJhbGciOi...

# Where the app is served from. Used to build invite links, so a partner's
# link opens the right place. Leave unset for local development and for most
# deployments — the app will use the address in the browser's address bar,
# which is correct in both. Set it only if the app is served from a different
# address than the one people open it at.
# VITE_PUBLIC_APP_URL=https://couple777.example.com
