# The compiled shadow of a test — the .ts is the file, and the test runner
# bundles it itself.
src/**/*.test.js

# Compiled output next to the sources. Vite resolves .js before .tsx, so a
# stale one of these silently becomes what the app ships — and `npm run build`
# does not regenerate them. The .tsx files are the source; nothing else.
src/**/*.js
