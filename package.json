{
  "name": "couple777",
  "private": true,
  "version": "0.1.0",
  "type": "module",
  "scripts": {
    "dev": "vite",
    "build": "tsc -b && tsc -p tsconfig.api.json && vite build",
    "preview": "vite preview",
    "typecheck": "tsc -b --pretty",
    "build:static": "VITE_ROUTER=hash vite build --outDir dist-preview",
    "test:rls": "node supabase/tests/rls.test.mjs",
    "dev:local": "node supabase/tests/local-server.mjs",
    "test:hosted": "node supabase/tests/hosted.e2e.mjs",
    "typecheck:api": "tsc -p tsconfig.api.json",
    "test:ai": "node --experimental-strip-types --no-warnings tests/memory-read.test.ts",
    "test:memory": "esbuild src/lib/memoryRead.test.ts --bundle --platform=node --format=esm --log-level=error --outfile=node_modules/.cache/memory.test.mjs && node node_modules/.cache/memory.test.mjs"
  },
  "dependencies": {
    "@anthropic-ai/sdk": "^0.124.0",
    "@supabase/supabase-js": "^2.58.0",
    "react": "^19.2.0",
    "react-dom": "^19.2.0",
    "react-router-dom": "^7.9.0"
  },
  "devDependencies": {
    "@electric-sql/pglite": "^0.5.8",
    "@types/node": "^26.4.1",
    "@types/react": "^19.2.0",
    "@types/react-dom": "^19.2.0",
    "@vercel/node": "^12.0.1",
    "@vitejs/plugin-react": "^5.0.0",
    "typescript": "^5.9.0",
    "vite": "^7.1.0"
  },
  "engines": {
    "node": ">=20"
  }
}
